# ResumeForge Environment Configuration
# Copy this file to .env.local for custom deployment settings

NODE_ENV=production
PORT=3000

# Authentication JWT Secret (Generate a strong random string in production)
JWT_SECRET=resumeforge-placement-super-secure-jwt-secret-key-2026-production

# Optional Database Connection (Default uses robust file-backed JSON/SQLite store)
# DATABASE_URL=postgresql://user:password@localhost:5432/resumeforge

# Optional AI Evaluation Integration (OpenAI or Gemini API key for enhanced interview feedback)
# GEMINI_API_KEY=your-gemini-api-key-here
